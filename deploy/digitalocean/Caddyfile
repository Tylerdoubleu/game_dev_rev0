# Caddy front door for the always-on paintball server.
# PAINTBALL_HOST is set in /etc/systemd/system/caddy.service.d/paintball.conf
# (e.g. 134-199-181-82.sslip.io). Caddy gets/renews TLS automatically
# (Let's Encrypt, falling back to ZeroSSL).
{$PAINTBALL_HOST} {
	# CORS for the GitHub Pages client calling /api/* (/api/lobbies, /api/profile*).
	# Preflight is answered here (never proxied), so Node never sees OPTIONS.
	@api_preflight {
		method OPTIONS
		path /api/*
	}
	handle @api_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Max-Age "600"
		respond 204
	}
	# "defer" replaces any value server.js sets, so there is exactly one header.
	# Not applied to OPTIONS, so it can't overwrite the preflight's Allow-Methods above.
	@api_cors {
		path /api/*
		not method OPTIONS
	}
	header @api_cors {
		defer
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, OPTIONS"
	}

	# Everything else (/, /healthz, /api/*, and the /ws WebSocket upgrade)
	# goes to the Node gateway (server/server.js), which pipes WS to Godot.
	reverse_proxy 127.0.0.1:8080
}

# TEST environment: the `test` branch, checked out at /opt/paintball-test/app and run by
# paintball-test-server (Node :8081 -> headless Godot :9081). Auto-pulled by
# paintball-test-update.timer. Unlike live, this host also serves the web client itself
# (the test checkout's committed docs/, same as Pages), so the page and its /ws share one origin.
{$PAINTBALL_TEST_HOST:test.jeetball.com} {
	@api_preflight {
		method OPTIONS
		path /api/*
	}
	handle @api_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Max-Age "600"
		respond 204
	}
	@api_cors {
		path /api/*
		not method OPTIONS
	}
	header @api_cors {
		defer
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, OPTIONS"
	}

	@server path /ws /ws/* /api/* /healthz
	handle @server {
		reverse_proxy 127.0.0.1:8081
	}

	# Static web client. Threads are off in the export, so no COOP/COEP is needed
	# (same as GitHub Pages). no-cache = browsers revalidate, so new test builds show up at once.
	handle {
		root * /opt/paintball-test/app/docs
		header Cache-Control "no-cache"
		@pck path *.pck
		header @pck Content-Type "application/octet-stream"
		encode gzip
		file_server
	}
}
