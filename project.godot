config_version=5

[application]

config/name="First-Person Paintball (Rev0 Prototype)"
config/description="Lightweight 3D First-Person Paintball prototype (v0.1.1-playtest)"
config/version="0.1.1-playtest"
run/main_scene="res://scenes/maps/speedball_arena_01/speedball_arena_01.tscn"
